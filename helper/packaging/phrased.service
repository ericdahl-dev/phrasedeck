[Unit]
Description=phrased: types phrases from phrasedeck into the focused window
# Start and stop with the graphical session. WAYLAND_DISPLAY comes from the user manager's
# environment, which uwsm imports at login; without it there is nothing to type into.
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
ExecStart=/usr/bin/phrased
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
